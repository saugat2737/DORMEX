# DORMEX PostgreSQL Configuration
# Default local development credentials
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dormex

# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Session & Security
COOKIE_SECRET=dormex-super-secure-production-ready-cookie-secret-2026
JWT_SECRET=dormex-super-secure-jwt-signing-key-2026

# Database Connection Pool Settings
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_SSL=false
